      "source": [
        "print(\"Using Temp\")\n",
        "a,b=10,5\n",
        "temp=a\n",
        "a=b\n",
        "b=temp\n",
        "print(a,b)\n",
        "print(\"Using ,\")\n",
        "a,b=10,5\n",
        "a,b=b,a\n",
        "print(a,b)\n",
        "print(\"Using + and -\")\n",
        "a,b=10,5\n",
        "a=a+b\n",
        "b=a-b\n",
        "a=a-b\n",
        "print(a,b)\n",
        "print(\"Using ^\")\n",
        "a,b=10,5\n",
        "a=a^b\n",
        "b=a^b\n",
        "a=a^b\n",
        "print(a,b)"
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "N=int(input(\"Enter max no. of candies:\"))\n",
        "K=int(input(\"Enter min no. of candies:\"))\n",
        "C=1\n",
        "R=N\n",
        "while(C==1):\n",
        "  M=int(input(\"Enter amout of candies needed:\"))\n",
        "  if(M>N):\n",
        "    print(\"invalid\")\n",
        "  else:\n",
        "    R=R-M\n",
        "    if(R<=K):\n",
        "      R=N\n",
        "    print(\"SOLD=\",M)\n",
        "    print(\"Remaining=\",R)\n",
        "    C=int(input(\"DO you want to continue(1or0):\"))"
      ],
      "metadata": {
